DirectoryIndex index.html
ErrorDocument 404 /404
# Public URLs omit .html; existing links keep their query strings on a permanent redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} "\s/+[^?\s]*\.html(?:[?\s])" [NC]
  RewriteRule ^([a-zA-Z0-9-]+)\.html$ /$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-zA-Z0-9-]+)$ $1.html [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "^(package(-lock)?\.json|.*\.md)$">
  Require all denied
</FilesMatch>

# Documentation/templates must not be served from a Git deployment.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/deployment(?:/|$)
</IfModule>
